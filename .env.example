# ── Gemini ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROUNDING_MODEL=gemini-2.5-flash

# ── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_OWNER_CHAT_ID=your_chat_id_here

# ── Tistory ─────────────────────────────────────────
TISTORY_ACCESS_TOKEN=your_tistory_access_token_here
# 발급: https://www.tistory.com/guide/api/manage/register → OAuth2 토큰
TISTORY_BLOG_NAME=your_blog_subdomain
# 블로그 주소: xxx.tistory.com → TISTORY_BLOG_NAME=xxx
TISTORY_CATEGORY_ID=0
# 0 = 분류 없음, 수동 확인: 티스토리 관리 페이지 → 카테고리 ID 복사

# ── Instagram ──────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your_instagram_long_lived_token_here
# 발급: Meta for Developers → Graph API Explorer
#        권한: instagram_basic, instagram_content_publish
#        Long-lived token 발급 (60일 유효, 커매스 토큰으로 손실없이 갱신 가능)
INSTAGRAM_USER_ID=your_instagram_business_user_id
# 확인: curl "https://graph.instagram.com/me?access_token=TOKEN" → id 필드

# ── Naver Blog ──────────────────────────────────────
NAVER_BLOG_ID=your_naver_blog_id
# blog.naver.com/{NAVER_BLOG_ID} 의 {NAVER_BLOG_ID}
NAVER_SESSION_PATH=naver_session.json
# 최초 1회 수동 로그인 후 Playwright storage_state()로 생성
# 생성 스크립트: python scripts/naver_login_once.py

# ── Threads (방향성 유지) ────────────────────────────
THREADS_ACCESS_TOKEN=your_threads_long_lived_token_here
THREADS_USER_ID=your_threads_user_id_here

# ── 실행 모드 ───────────────────────────────────────
DRY_RUN=true        # true: 실제 발행 안 함 / false: 실제 발행
LOG_LEVEL=INFO
